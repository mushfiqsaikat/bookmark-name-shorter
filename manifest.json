{
  "manifest_version": 3,
  "name": "Short Bookmark Names",
  "version": "1.0.2",
  "description": "Keeps only the part of a bookmark title before the first spaced hyphen.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["bookmarks"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
