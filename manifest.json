{
  "manifest_version": 3,
  "name": "Bookmark Name Shorter",
  "version": "1.0.7",
  "description": "Keeps only the part of a bookmark title before common site-name separators.",
  "icons": {
    "16": "icons/icon16.png",
    "24": "icons/icon24.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Bookmark Name Shorter",
    "default_icon": {
      "16": "icons/icon16.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["bookmarks"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
